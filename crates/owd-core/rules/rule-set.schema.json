{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/African-River-Corridors/open-vessel-concept-drawings/crates/arc-rules/rule-set.schema.json",
  "title": "ARC Rule Set (schema 1.x)",
  "description": "One version of a Rule Set (spec 0004, 'Rule Set (data)'; ADR 0013). Schema 1.x is frozen: changes are additive only. The loader of the arc-rules crate checks the same fields, and also what a schema cannot: the rule id against its locator, repeated ids, table names and conflicts between two constant Criteria.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "family", "title", "version", "edition", "sources", "status", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/$defs/word", "description": "The set id, for example igc-2g." },
    "family": { "$ref": "#/$defs/word", "description": "The first segment of every rule id in the set." },
    "title": { "$ref": "#/$defs/text" },
    "version": { "$ref": "#/$defs/semver", "description": "The set's encoding of the edition. Patch: same content hash. Minor: Rules added. Major: a Rule changed or removed." },
    "edition": {
      "type": "object",
      "description": "The source edition: document, edition, amendments included, in-force date.",
      "required": ["document"],
      "properties": { "document": { "$ref": "#/$defs/text" } },
      "additionalProperties": { "type": "string" }
    },
    "sources": {
      "type": "array",
      "description": "Each text read, with the SHA-256 of the file read.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "edition", "access", "sha256"],
        "properties": {
          "document": { "$ref": "#/$defs/text" },
          "edition": { "$ref": "#/$defs/text" },
          "url": { "type": "string" },
          "access": { "$ref": "#/$defs/access" },
          "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" }
        }
      }
    },
    "status": { "enum": ["draft", "stable"] },
    "applies_when": { "$ref": "#/$defs/applicability" },
    "includes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "$ref": "#/$defs/text" },
          "version": { "$ref": "#/$defs/semver" }
        }
      }
    },
    "known_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rules", "reason"],
        "properties": {
          "rules": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
          "reason": { "$ref": "#/$defs/text" }
        }
      }
    },
    "tables": { "type": "array", "items": { "$ref": "#/$defs/table" } },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "word": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "access": { "enum": ["free", "paywalled", "sign-up"] },
    "role": { "enum": ["maintainer", "expert-reviewer", "agent"], "description": "A role, never a person's name: the repository is public." },
    "compare": { "enum": ["ge", "gt", "le", "lt"] },
    "applicability": {
      "type": "object",
      "description": "A conjunction of input in {values}. Empty means always.",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document": { "type": "string" },
        "edition": { "type": "string" },
        "locator": { "type": "string" },
        "also": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "page": { "type": "string" },
        "access": { "anyOf": [{ "$ref": "#/$defs/access" }, { "const": "" }] }
      }
    },
    "operand": {
      "description": "A formula operand: a Measure id, or a table row picked by a Measure value.",
      "anyOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "at"],
          "properties": { "table": { "$ref": "#/$defs/text" }, "at": { "$ref": "#/$defs/text" } }
        }
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "input", "unit", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "source": { "$ref": "#/$defs/citation" },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": { "name": { "$ref": "#/$defs/text" }, "unit": { "type": "string" } }
        },
        "unit": { "$ref": "#/$defs/text" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["when", "shape"],
            "properties": {
              "when": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "ge": { "type": "number" },
                      "gt": { "type": "number" },
                      "le": { "type": "number" },
                      "lt": { "type": "number" }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["in"],
                    "properties": { "in": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
                  }
                ]
              },
              "shape": { "$ref": "#/$defs/text" }
            },
            "additionalProperties": { "type": "number" }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "origin", "source", "codified", "verified", "kind", "measure", "consequence", "evaluated", "since"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*/[A-Za-z0-9][A-Za-z0-9.()-]*/[a-z0-9][a-z0-9-]*$",
          "description": "<family>/<paragraph>/<slug>. For a regulation, class, guideline or national-practice Rule the paragraph is the locator with spaces removed."
        },
        "title": { "$ref": "#/$defs/text" },
        "origin": { "enum": ["regulation", "class", "method-validity", "physical", "tool-limit", "guideline", "national-practice"] },
        "source": { "$ref": "#/$defs/citation" },
        "codified": {
          "type": "object",
          "additionalProperties": false,
          "required": ["by", "date", "review"],
          "properties": {
            "by": { "$ref": "#/$defs/role" },
            "date": { "$ref": "#/$defs/text" },
            "review": { "$ref": "#/$defs/text" }
          }
        },
        "verified": {
          "anyOf": [
            { "const": false },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["by", "date", "edition_held", "locator_read", "review"],
              "properties": {
                "by": { "$ref": "#/$defs/role" },
                "date": { "$ref": "#/$defs/text" },
                "edition_held": { "$ref": "#/$defs/text" },
                "locator_read": { "$ref": "#/$defs/text" },
                "review": { "$ref": "#/$defs/text" }
              }
            }
          ]
        },
        "applies_when": { "$ref": "#/$defs/applicability" },
        "kind": { "enum": ["limit", "table", "formula", "check", "note"] },
        "measure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "$ref": "#/$defs/text" },
            "args": { "type": "object", "additionalProperties": { "type": ["number", "string"] } }
          }
        },
        "compare": { "$ref": "#/$defs/compare" },
        "limit": { "type": "object", "required": ["unit"], "properties": { "unit": { "$ref": "#/$defs/text" } } },
        "tolerance": { "type": "number", "minimum": 0 },
        "consequence": { "enum": ["block", "warn", "note"] },
        "sizes": { "type": "boolean" },
        "evaluated": { "type": "boolean" },
        "gap": { "type": ["string", "null"] },
        "finding": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^#[0-9]+$" }] },
        "since": { "$ref": "#/$defs/semver" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "limit" } } },
          "then": {
            "required": ["compare", "limit"],
            "properties": {
              "limit": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "unit"],
                "properties": { "value": { "type": "number" }, "unit": { "$ref": "#/$defs/text" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "table" } } },
          "then": {
            "required": ["compare", "limit"],
            "properties": {
              "limit": {
                "type": "object",
                "additionalProperties": false,
                "required": ["table", "at", "unit"],
                "properties": {
                  "table": { "$ref": "#/$defs/text" },
                  "at": { "$ref": "#/$defs/text" },
                  "unit": { "$ref": "#/$defs/text" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "formula" } } },
          "then": {
            "required": ["compare", "limit"],
            "properties": {
              "limit": {
                "type": "object",
                "required": ["shape", "unit"],
                "properties": { "shape": { "$ref": "#/$defs/text" }, "unit": { "$ref": "#/$defs/text" } },
                "additionalProperties": { "anyOf": [{ "type": "number" }, { "$ref": "#/$defs/operand" }] }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "enum": ["check", "note"] } } },
          "then": { "not": { "anyOf": [{ "required": ["compare"] }, { "required": ["limit"] }] } }
        },
        {
          "if": { "properties": { "kind": { "const": "note" } } },
          "then": { "properties": { "consequence": { "const": "note" } } },
          "else": { "properties": { "consequence": { "enum": ["block", "warn"] } } }
        },
        {
          "if": { "properties": { "evaluated": { "const": false } } },
          "then": { "required": ["gap"], "properties": { "gap": { "type": "string", "pattern": "\\S" } } },
          "else": { "properties": { "gap": { "type": "null" } } }
        },
        {
          "if": { "properties": { "origin": { "enum": ["regulation", "class", "guideline", "national-practice"] } } },
          "then": { "properties": { "source": { "required": ["locator"], "properties": { "locator": { "$ref": "#/$defs/text" } } } } }
        }
      ]
    }
  }
}
