{
  "style_version": 1,
  "name": "owd-default",
  "sheets": {
    "xs": {
      "size": "A3",
      "orientation": "landscape"
    },
    "ts": {
      "size": "A1",
      "orientation": "landscape"
    },
    "so": {
      "size": "A3",
      "orientation": "landscape"
    }
  },
