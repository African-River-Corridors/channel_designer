{
  "style_version": 1,
  "name": "owd-default",
  "sheets": {
    "xs": {
      "size": "A3",
      "orientation": "landscape"
    },
    "ts": {
      "size": "A1",
      "orientation": "landscape"
    },
    "so": {
      "size": "A3",
      "orientation": "landscape"
    },
    "pl": {
      "size": "A1",
      "orientation": "landscape"
    }
  },
  "layers": {
    "GRID": true,
    "HATCH": true,
    "WATER": true
  },
  "sections": {
    "spacing_m": 500,
    "extra": [
      {
        "rule": "bend-middle"
      },
      {
        "rule": "constraint-worst"
      }
    ]
  },
  "gallery": {
    "scales": [
      200,
      250,
      500,
      1000,
      2000,
      5000,
      10000
    ],
    "min_columns": 2,
    "gap_mm": 2,
    "margin_m": 15,
    "min_half_m": 60,
    "below_invert_m": 4,
    "above_ground_m": 3,
    "label_pitch_mm": 12,
    "hatch_min_cut_m": 0.001,
    "bands_mm": {
      "left": 10,
      "right": 3,
      "top": 17,
      "bottom": 8
    }
  },
  "typical": {
    "scales": [
      20,
      25,
      50,
      100,
      200,
      250,
      500
    ],
    "min_dimension_mm": 8,
    "margins_mm": {
      "left": 8,
      "right": 25,
      "below": 20,
      "above": 14
    },
    "detail_scales": [
      20,
      25,
      50,
      100
    ]
  },
  "setting_out": {
    "spacing_m": 100,
    "row_pitch_mm": 4.5
  },
  "plan": {
    "strip_scale": 5000,
    "overlap_m": 50,
    "margin_m": 30,
    "tick_mm": 8,
    "tick_label_every": 5,
    "relief": {
      "azimuth_deg": 315,
      "altitude_deg": 45,
      "z_factor": 1,
      "pixel_mm": 0.5,
      "quality": 85
    },
    "label_rules": [
      {
        "rule": "bend-tighter-than",
        "k": 1
      },
      {
        "rule": "infeasible-stretch"
      },
      {
        "rule": "constraint-stretch",
        "fields": [
          "kind",
          "deficit",
          "works",
          "chainage"
        ]
      }
    ]
  }
}
