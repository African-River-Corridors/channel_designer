{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/African-River-Corridors/open-waterway-designer/schema/owd-style.schema.json",
  "title": "OWD sheet style",
  "description": "What a drawing sheet shows (spec 0004): sheet sizes, scales, layers, which sections to draw and how a panel is laid out. The built-in default is owd-default.style.json. A user's file may hold only the members it changes; it is laid over the default, then checked against this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "style_version",
    "name",
    "sheets",
    "layers",
    "sections",
    "gallery",
    "typical",
    "setting_out",
    "plan"
  ],
  "properties": {
    "style_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "sheets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xs",
        "ts",
        "so",
        "pl"
      ],
      "properties": {
        "xs": {
          "$ref": "#/$defs/sheet"
        },
        "ts": {
          "$ref": "#/$defs/sheet"
        },
        "so": {
          "$ref": "#/$defs/sheet"
        },
        "pl": {
          "$ref": "#/$defs/sheet"
        }
      }
    },
    "layers": {
      "description": "The optional layers, on or off, on every sheet.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GRID",
        "HATCH",
        "WATER"
      ],
      "properties": {
        "GRID": {
          "type": "boolean"
        },
        "HATCH": {
          "type": "boolean"
        },
        "WATER": {
          "type": "boolean"
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spacing_m",
        "extra"
      ],
      "properties": {
        "spacing_m": {
          "description": "A section at every multiple of this chainage, in metres.",
          "type": "number",
          "minimum": 1
        },
        "extra": {
          "description": "Extra sections, each a named rule. Take a rule out to turn it off.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule"
            ],
            "properties": {
              "rule": {
                "description": "bend-middle: the tightest point of each tight bend. constraint-worst: the worst station of each constraint stretch of the screening (spec 0007).",
                "enum": [
                  "bend-middle",
                  "constraint-worst"
                ]
              }
            }
          }
        }
      }
    },
    "gallery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scales",
        "min_columns",
        "gap_mm",
        "margin_m",
        "min_half_m",
        "below_invert_m",
        "above_ground_m",
        "label_pitch_mm",
        "hatch_min_cut_m",
        "bands_mm"
      ],
      "properties": {
        "scales": {
          "description": "The scales to try, the largest scale first: the first at which every panel fits is used for all of them.",
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              1,
              2,
              5,
              10,
              20,
              25,
              50,
              100,
              200,
              250,
              500,
              1000,
              1250,
              2000,
              2500,
              5000,
              10000,
              20000,
              50000,
              100000
            ]
          }
        },
        "min_columns": {
          "description": "The fewest panels side by side that a scale must allow.",
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "gap_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "margin_m": {
          "description": "Room round the wet channel, in metres.",
          "type": "number",
          "minimum": 0
        },
        "min_half_m": {
          "description": "The least half-width of a panel, in metres.",
          "type": "number",
          "minimum": 1
        },
        "below_invert_m": {
          "type": "number",
          "minimum": 0
        },
        "above_ground_m": {
          "type": "number",
          "minimum": 0
        },
        "label_pitch_mm": {
          "description": "The least paper distance between two axis labels.",
          "type": "number",
          "minimum": 4
        },
        "hatch_min_cut_m": {
          "description": "A cut thinner than this is not hatched.",
          "type": "number",
          "minimum": 0
        },
        "bands_mm": {
          "description": "The bands of a panel for axis labels and headings.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "right",
            "top",
            "bottom"
          ],
          "properties": {
            "left": {
              "type": "number",
              "minimum": 0
            },
            "right": {
              "type": "number",
              "minimum": 0
            },
            "top": {
              "type": "number",
              "minimum": 17
            },
            "bottom": {
              "type": "number",
              "minimum": 8
            }
          }
        }
      }
    },
    "typical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scales",
        "min_dimension_mm",
        "margins_mm",
        "detail_scales"
      ],
      "properties": {
        "scales": {
          "description": "The scales to try, the largest scale first: the first at which the section fits and every dimension is long enough is used.",
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              1,
              2,
              5,
              10,
              20,
              25,
              50,
              100,
              200,
              250,
              500,
              1000,
              1250,
              2000,
              2500,
              5000,
              10000,
              20000,
              50000,
              100000
            ]
          }
        },
        "min_dimension_mm": {
          "description": "The shortest dimension line on paper: the standard needs room for two arrowheads (clause 12.4.3).",
          "type": "number",
          "minimum": 8
        },
        "margins_mm": {
          "description": "Room round the section for dimensions and labels, on paper.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "right",
            "below",
            "above"
          ],
          "properties": {
            "left": {
              "type": "number",
              "minimum": 0
            },
            "right": {
              "type": "number",
              "minimum": 0
            },
            "below": {
              "type": "number",
              "minimum": 0
            },
            "above": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "detail_scales": {
          "description": "The scales to try for the detail of the under-keel clearance, the largest scale first: the first at which the dimension is long enough and fits is used. The clearance is too small to dimension at the scale of the section.",
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              1,
              2,
              5,
              10,
              20,
              25,
              50,
              100,
              200,
              250,
              500,
              1000,
              1250,
              2000,
              2500,
              5000,
              10000,
              20000,
              50000,
              100000
            ]
          }
        }
      }
    },
    "setting_out": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spacing_m",
        "row_pitch_mm"
      ],
      "properties": {
        "spacing_m": {
          "description": "A row of the setting-out table at every multiple of this chainage, in metres, and one at the end of the line.",
          "type": "number",
          "minimum": 1
        },
        "row_pitch_mm": {
          "description": "The distance between two rows on paper.",
          "type": "number",
          "minimum": 4.5
        }
      }
    },
    "plan": {
      "description": "The plan sheets (spec 0004, ticket 5): an overview of the whole line, then strips along chainage.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strip_scale",
        "overlap_m",
        "margin_m",
        "tick_mm",
        "tick_label_every",
        "relief",
        "label_rules"
      ],
      "properties": {
        "strip_scale": {
          "description": "The scale of every strip (a denominator of the standard).",
          "type": "integer",
          "minimum": 1
        },
        "overlap_m": {
          "type": "number",
          "description": "How far a strip runs past its match lines, in metres of chainage.",
          "minimum": 0
        },
        "margin_m": {
          "type": "number",
          "description": "Room round the channel footprint in a window, in metres.",
          "minimum": 0
        },
        "tick_mm": {
          "type": "number",
          "description": "The least paper distance between two chainage ticks, in millimetres; the step is 1, 2 or 5 times a power of ten.",
          "minimum": 1
        },
        "tick_label_every": {
          "description": "Every how many ticks a chainage is written.",
          "type": "integer",
          "minimum": 1
        },
        "relief": {
          "description": "The shaded relief behind the plan, from the design DEM.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "azimuth_deg",
            "altitude_deg",
            "z_factor",
            "pixel_mm",
            "quality"
          ],
          "properties": {
            "azimuth_deg": {
              "type": "number",
              "description": "Where the light comes from, clockwise from grid north.",
              "minimum": 0,
              "maximum": 360
            },
            "altitude_deg": {
              "type": "number",
              "description": "The height of the light above the horizon.",
              "maximum": 90,
              "minimum": 1
            },
            "z_factor": {
              "type": "number",
              "description": "The vertical scale of the relief only (not of the drawing).",
              "minimum": 0.01
            },
            "pixel_mm": {
              "type": "number",
              "description": "The size of one relief pixel on the paper, in millimetres.",
              "minimum": 0.1,
              "maximum": 5
            },
            "quality": {
              "description": "The JPEG quality.",
              "type": "integer",
              "minimum": 10,
              "maximum": 100
            }
          }
        },
        "label_rules": {
          "description": "The label rules: a sheet labels only what a rule here finds. Leave a rule out to turn it off.",
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rule",
                  "k"
                ],
                "properties": {
                  "rule": {
                    "const": "bend-tighter-than"
                  },
                  "k": {
                    "type": "number",
                    "description": "Label a bend whose least radius is below k times the least bend radius of the ruleset.",
                    "minimum": 0.01
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rule"
                ],
                "properties": {
                  "rule": {
                    "const": "infeasible-stretch"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rule",
                  "fields"
                ],
                "properties": {
                  "rule": {
                    "const": "constraint-stretch"
                  },
                  "fields": {
                    "description": "What the label of each constraint stretch shows, in this order: kind (what falls short), deficit (by how much), works (what would fix it), chainage (its range).",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "enum": [
                        "kind",
                        "deficit",
                        "works",
                        "chainage"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "orientation"
      ],
      "properties": {
        "size": {
          "enum": [
            "A0",
            "A1",
            "A2",
            "A3",
            "A4"
          ]
        },
        "orientation": {
          "enum": [
            "landscape",
            "portrait"
          ]
        }
      }
    }
  }
}
