{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/African-River-Corridors/open-waterway-designer/schema/owd.schema.json",
  "title": "Open Waterway Designer document (.owd), format version 2",
  "description": "One screening study of one river reach for one vessel: its inputs, the choices made and the results of each stage. Each stage records a hash of what it depended on; a stage whose hash no longer matches is stale. Numbers are SI. Geometry is GeoJSON in the project CRS.",
  "type": "object",
  "required": ["format_version", "engine_version", "project", "inputs", "stages", "options"],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "description": "3 since spec 0007 (the Rule Set selection). An older file is refused, with no migration: rebuild the design.",
      "const": 3
    },
    "engine_version": { "type": "string", "minLength": 1 },
    "project": {
      "type": "object",
      "required": ["title", "created", "crs", "source_crs"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "created": { "type": "string", "minLength": 10 },
        "crs": {
          "description": "The project CRS: WGS84 / UTM. Null until the first import.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["epsg", "name"],
              "additionalProperties": false,
              "properties": {
                "epsg": { "type": "integer", "minimum": 32601, "maximum": 32760 },
                "name": { "type": "string" }
              }
            }
          ]
        },
        "source_crs": {
          "description": "The CRS each input came in, by input name, as EPSG:nnnn.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["left_bank", "right_bank", "centreline", "river_polygon", "dem"],
      "additionalProperties": false,
      "properties": {
        "left_bank": { "$ref": "#/$defs/line_or_null" },
        "right_bank": { "$ref": "#/$defs/line_or_null" },
        "centreline": { "$ref": "#/$defs/line_or_null" },
        "river_polygon": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/polygon" }]
        },
        "dem": {
          "description": "The DEM is referenced, never embedded: path relative to the document, SHA-256 of the file, its CRS and nodata value.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["path", "sha256", "crs", "nodata"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                "crs": { "type": "string" },
                "nodata": { "type": ["number", "null"] },
                "source": {
                  "description": "Where a fetched DEM came from (`owd fetch-dem`): the dataset, its licence notice, and each tile with its file, SHA-256, size and URL.",
                  "type": "object",
                  "required": ["name", "licence", "tiles"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "licence": { "type": "string" },
                    "tiles": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["name", "file", "sha256", "bytes", "url"],
                        "additionalProperties": false,
                        "properties": {
                          "name": { "type": "string" },
                          "file": { "type": "string" },
                          "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                          "bytes": { "type": "integer", "minimum": 0 },
                          "url": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "bed_model": {
          "description": "Spec 0012: the bed of the river where there is no survey, from a depth profile. Inside the water, bed = water level - depth x shape. The depth is read along the river centreline from `points` of [river chainage in metres, depth in metres], linear between points and flat beyond the first and last; the shape is a parabola across the water, 1 at the centreline and 0 at the banks. Outside the water the DEM is read as before. The depth is assumed, not measured: every output that used it says so. A survey later replaces it. Optional.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["points", "shape", "season"],
              "additionalProperties": false,
              "properties": {
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "type": "number" }
                  }
                },
                "shape": { "const": "parabola" },
                "season": {
                  "description": "The season the depths hold for, for example `dry`. Free text.",
                  "type": ["string", "null"]
                }
              }
            }
          ]
        },
        "water_level": {
          "description": "The water level as a profile along the river centreline (ADR 0006): points of [river chainage in metres, level in metres], read linearly between points and held flat beyond the first and last. Two points at one chainage make a step. A design line's station takes its level by projecting onto the river centreline. Optional: a document made before the profile has none.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["points"],
              "additionalProperties": false,
              "properties": {
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "type": "number" }
                  }
                }
              }
            }
          ]
        },
        "seed_legs": {
          "description": "Spec 0005: ordered lines joined into one design line before the rolling circle (`join_legs`). Optional.",
          "type": "array",
          "items": { "$ref": "#/$defs/line" }
        },
        "fixed": {
          "description": "Spec 0005: pieces the joined line must hold exactly. A pose is a point and a heading in degrees counter-clockwise from the project CRS's +x (east) axis. Optional.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_pose": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pose" }] },
            "end_pose": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pose" }] },
            "must_follow": { "type": "array", "items": { "$ref": "#/$defs/line" } }
          }
        }
      }
    },
    "stages": {
      "type": "object",
      "required": ["sizing", "alignment", "optimise", "volumes"],
      "additionalProperties": false,
      "properties": {
        "sizing": { "$ref": "#/$defs/sizing_stage" },
        "alignment": { "$ref": "#/$defs/alignment_stage" },
        "optimise": { "$ref": "#/$defs/stage" },
        "volumes": { "$ref": "#/$defs/stage" }
      }
    },
    "fits": {
      "description": "The answer to \"what fits\" over every vessel class (spec 0012). It is not a stage: it never reruns by itself, and it shows as stale when the banks or the centreline change.",
      "$ref": "#/$defs/stage"
    },
    "options": {
      "description": "Design line options, added by the alignment and optimise stages.",
      "type": "array",
      "items": { "type": "object" }
    },
    "reach": {
      "description": "Spec 0012: the reach the study was started from. Start, end and via points and the trace are the user's own longitude-latitude clicks. The route is OSM way ids only, never OSM geometry (ODbL); a stretch with no waterway near it is kept as the user drew it, kind `as-drawn`. Optional.",
      "type": "object",
      "required": ["start", "end", "route"],
      "additionalProperties": false,
      "properties": {
        "river": { "type": ["string", "null"] },
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" },
        "via": { "type": "array", "items": { "$ref": "#/$defs/position" } },
        "trace": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } }
          ]
        },
        "length_m": { "type": "number", "minimum": 0 },
        "route": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["waterway", "as-drawn"] },
              "way_ids": { "type": "array", "items": { "type": "integer" } },
              "line": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } }
            }
          }
        }
      }
    },
    "low_confidence_width": {
      "description": "Spec 0012: stretches of the generated banks where the water was too narrow to trust (under `min_width_m`) or was not found. Chainage is along the generated centreline, in metres from its start. Optional.",
      "type": "object",
      "required": ["min_width_m", "stretches"],
      "additionalProperties": false,
      "properties": {
        "min_width_m": { "type": "number", "minimum": 0 },
        "provisional": { "type": "boolean" },
        "source": { "type": "string" },
        "stretches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from_m", "to_m", "kind"],
            "additionalProperties": false,
            "properties": {
              "from_m": { "type": "number" },
              "to_m": { "type": "number" },
              "kind": { "enum": ["narrow", "no-water"] },
              "min_width_m": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "provenance": {
      "description": "Spec 0012: where each generated input came from, by input name. Optional: a document with none gives the same results. Each record names its source (an `owd-reach` registry id), its date, the licence notice that travels into every export, and a mark: `default` (made by OWD), `edited` (a default the user changed) or `user` (the user's own).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left_bank": { "$ref": "#/$defs/provenance_record" },
        "right_bank": { "$ref": "#/$defs/provenance_record" },
        "centreline": { "$ref": "#/$defs/provenance_record" },
        "river_polygon": { "$ref": "#/$defs/provenance_record" },
        "dem": { "$ref": "#/$defs/provenance_record" },
        "water_level": { "$ref": "#/$defs/provenance_record" },
        "route": { "$ref": "#/$defs/provenance_record" },
        "bed": { "$ref": "#/$defs/provenance_record" }
      }
    }
  },
  "$defs": {
    "provenance_record": {
      "type": "object",
      "required": ["source", "date", "notice", "mark"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 4 },
        "notice": { "type": "string", "minLength": 1 },
        "mark": { "enum": ["default", "edited", "user"] },
        "provisional": {
          "description": "True while the default behind this input is not yet calibrated (spec 0012).",
          "type": "boolean"
        },
        "settings": {
          "description": "The parameters the input was made with (for example the JRC mask threshold), so a reviewer can see which choices are provisional defaults.",
          "type": "object"
        }
      }
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "line": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "LineString" },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/position" }
        }
      }
    },
    "line_or_null": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/line" }] },
    "polygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": { "$ref": "#/$defs/position" }
          }
        }
      }
    },
    "hash_or_null": { "type": ["string", "null"], "minLength": 64, "maxLength": 64 },
    "pose": {
      "type": "object",
      "required": ["point", "heading_deg"],
      "additionalProperties": false,
      "properties": {
        "point": { "$ref": "#/$defs/position" },
        "heading_deg": { "type": "number" }
      }
    },
    "stage": {
      "type": "object",
      "required": ["settings", "results", "depends_on", "engine_version"],
      "additionalProperties": false,
      "properties": {
        "settings": { "type": ["object", "null"] },
        "results": { "type": ["object", "null"] },
        "depends_on": { "$ref": "#/$defs/hash_or_null" },
        "engine_version": { "type": ["string", "null"] }
      }
    },
    "alignment_stage": {
      "type": "object",
      "required": ["settings", "results", "depends_on", "engine_version"],
      "additionalProperties": false,
      "properties": {
        "settings": {
          "description": "Settings of each alignment method, by method name. A setting left out takes its default.",
          "type": ["object", "null"],
          "properties": {
            "rolling_circle": {
              "type": "object",
              "properties": {
                "use_water": {
                  "description": "Spec 0005: the water-aware rolling circle. Null (the default) means on when the inputs have a river polygon. A version 1 document records false when it opens, so its results do not change.",
                  "type": ["boolean", "null"]
                },
                "clearance_m": {
                  "description": "Spec 0005: clearance from the bank, metres, added to half the bottom width when the water is shrunk to navigable water. Default 0.",
                  "type": "number",
                  "minimum": 0
                },
                "r_pref_m": {
                  "description": "Spec 0005: a preferred radius for the fairway fit, metres; bends tighter than it are penalised, never refused. Default none.",
                  "type": ["number", "null"],
                  "minimum": 0
                }
              }
            },
            "reroute": {
              "type": "object",
              "properties": {
                "fairness_weight": {
                  "description": "Weight on the squared change of heading between stations in the least-cost re-route (spec 0005). 0, the default, gives the re-route without it.",
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "results": { "type": ["object", "null"] },
        "depends_on": { "$ref": "#/$defs/hash_or_null" },
        "engine_version": { "type": ["string", "null"] }
      }
    },
    "sizing_stage": {
      "type": "object",
      "required": ["settings", "results", "depends_on", "engine_version"],
      "additionalProperties": false,
      "properties": {
        "settings": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["rule_sets", "set_inputs", "vessel_standard_id", "draught_m"],
              "additionalProperties": false,
              "properties": {
                "rule_sets": {
                  "description": "The selected Rule Sets (spec 0007), in selection order. `owd` is always selected. `source` says whether the user chose the set (`typed`) or the tool did (`default`).",
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "version", "hash", "source"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
                      "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                      "source": { "enum": ["default", "typed"] }
                    }
                  }
                },
                "set_inputs": {
                  "description": "The inputs the selected sets apply on, such as `se_quality`, each with its source.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "value", "source"],
                    "additionalProperties": false,
                    "properties": {
                      "name": { "type": "string", "minLength": 1 },
                      "value": { "type": "string", "minLength": 1 },
                      "source": { "enum": ["default", "typed"] }
                    }
                  }
                },
                "vessel_standard_id": { "type": ["string", "null"], "minLength": 1 },
                "draught_m": { "type": ["number", "null"], "minimum": 0 }
              }
            }
          ]
        },
        "results": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": [
                "ruleset_id", "vessel_standard_id", "loa_m", "beam_m", "draught_m", "formation",
                "bottom_width_straight_m", "min_bend_radius_m", "design_depth_m",
                "bend_widening_at_rmin_m", "bottom_width_at_rmin_m", "width_basis", "source",
                "warnings"
              ],
              "properties": {
                "loa_m": { "type": "number" },
                "beam_m": { "type": "number" },
                "draught_m": { "type": "number" },
                "bottom_width_straight_m": { "type": "number" },
                "min_bend_radius_m": { "type": "number" },
                "design_depth_m": { "type": "number" },
                "warnings": { "type": "array", "items": { "type": "string" } }
              }
            }
          ]
        },
        "depends_on": { "$ref": "#/$defs/hash_or_null" },
        "engine_version": { "type": ["string", "null"] }
      }
    }
  }
}
